# Archon TRAXIS - Production Environment Configuration
# STORY 02.04: Production Environment & Deployment
#
# Copy this file to .env and configure for your production environment

# === ENVIRONMENT CONFIGURATION ===
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# === REQUIRED: DATABASE CONFIGURATION ===
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here-not-anon-key

# === OPTIONAL: EXTERNAL SERVICES ===
# OpenAI API for AI features (optional but recommended)
OPENAI_API_KEY=sk-your-openai-api-key

# Logfire for observability (optional)
LOGFIRE_TOKEN=your-logfire-token

# === SERVICE PORTS ===
ARCHON_SERVER_PORT=8181
ARCHON_MCP_PORT=8051
ARCHON_AGENTS_PORT=8052
ARCHON_UI_PORT=3737

# === PERFORMANCE CONFIGURATION ===
# Worker processes for backend (default: 4)
WORKER_PROCESSES=4

# Maximum concurrent connections (default: 1000)
MAX_CONNECTIONS=1000

# Connection timeout in seconds (default: 30)
CONNECTION_TIMEOUT=30

# === SECURITY CONFIGURATION ===
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3737,https://your-domain.com

# API key header name for authentication
API_KEY_HEADER=X-API-Key

# Enforce HTTPS in production (recommended: true)
HTTPS_ONLY=false

# External host/domain for production deployment
EXTERNAL_HOST=localhost

# === MONITORING CONFIGURATION ===
# Enable Prometheus metrics collection
PROMETHEUS_ENABLED=true

# Enable Grafana dashboard
GRAFANA_ENABLED=true

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=30

# Grafana admin password (change this!)
GRAFANA_ADMIN_PASSWORD=admin

# Grafana root URL for production
GRAFANA_ROOT_URL=http://localhost:3000

# === OPTIONAL: AGENTS CONFIGURATION ===
# Enable AI agents service (optional - requires more resources)
AGENTS_ENABLED=false

# Number of agent worker processes
AGENT_WORKERS=2

# Model cache size for agents
MODEL_CACHE_SIZE=1G

# AI inference timeout in seconds
INFERENCE_TIMEOUT=60

# === OPTIONAL: ADVANCED CONFIGURATION ===
# Service discovery mode (docker_compose for Docker deployment)
SERVICE_DISCOVERY_MODE=docker_compose

# MCP transport protocol (sse for server-sent events)
TRANSPORT=sse

# Enable various UI features
VITE_ALLOWED_HOSTS=localhost
VITE_SHOW_DEVTOOLS=false
VITE_CSP_ENABLED=true

# === OPTIONAL: LOAD BALANCER/PROXY CONFIGURATION ===
# HTTP port for Nginx (if using reverse proxy)
HTTP_PORT=80

# HTTPS port for Nginx (if using SSL)
HTTPS_PORT=443

# Prometheus port
PROMETHEUS_PORT=9090

# Grafana port
GRAFANA_PORT=3000

# === OPTIONAL: MCP REQUEST CONFIGURATION ===
# MCP request timeout in seconds
MCP_REQUEST_TIMEOUT=30

# Maximum concurrent MCP requests
MAX_CONCURRENT_REQUESTS=100

# === BACKUP CONFIGURATION ===
# Automatic backup enabled
BACKUP_ENABLED=true

# Backup retention days
BACKUP_RETENTION_DAYS=30

# === SSL/TLS CONFIGURATION (if using HTTPS) ===
# Path to SSL certificate (if using HTTPS)
# SSL_CERT_PATH=/etc/ssl/certs/archon.crt

# Path to SSL private key (if using HTTPS)
# SSL_KEY_PATH=/etc/ssl/certs/archon.key

# === PRODUCTION DEPLOYMENT NOTES ===
#
# 1. REQUIRED CHANGES:
#    - Set SUPABASE_URL and SUPABASE_SERVICE_KEY from your Supabase project
#    - Change GRAFANA_ADMIN_PASSWORD to a secure password
#    - Set EXTERNAL_HOST to your production domain/IP
#    - Configure ALLOWED_ORIGINS for your production domain
#
# 2. RECOMMENDED CHANGES:
#    - Set OPENAI_API_KEY for full AI functionality
#    - Set HTTPS_ONLY=true for production security
#    - Configure SSL certificates for HTTPS
#    - Set LOG_LEVEL=WARNING or ERROR for production
#    - Enable BACKUP_ENABLED=true
#
# 3. SCALING CONFIGURATION:
#    - Increase WORKER_PROCESSES based on your CPU cores
#    - Adjust MAX_CONNECTIONS based on expected load
#    - Enable AGENTS_ENABLED=true if you need AI processing
#
# 4. MONITORING:
#    - Keep PROMETHEUS_ENABLED=true for metrics
#    - Keep GRAFANA_ENABLED=true for dashboards
#    - Set LOGFIRE_TOKEN if using Logfire for observability
#
# 5. SECURITY:
#    - Never commit this .env file with real credentials to version control
#    - Use environment-specific .env files for different deployments
#    - Consider using Docker secrets or external secret management
#    - Regularly rotate API keys and database credentials